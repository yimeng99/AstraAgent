# .env.example — 复制为 .env 并填入真实值
#
# 本文件只包含示例值。真实凭证保存在本地 .env，不得提交到 Git。
#
# `cp .env.example .env` 后开始填：

# ── LLM provider 预设（默认 MiniMax Token Plan）─────────────
# 支持：openai / MiniMax / deepseek / zhipu / moonshot / anthropic / custom
# 详见 src/core/llm.py PROVIDER_PRESETS
LLM_PROVIDER=MiniMax
# 各 provider 预设的 base_url 在 src/core/llm.py，不显式设置时自动用预设值
# LLM_BASE_URL=https://api.MiniMax.com/v1   # MiniMax 兼容 OpenAI 协议
LLM_MODEL=MiniMax-M2                       # 不设置时用预设 default_model

# 必填：API key（格式因 provider 而异）
LLM_API_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx
#   OpenAI      : sk-...
#   MiniMax : eyJ... (JWT)
#   DeepSeek    : sk-...
#   Zhipu       : <hex>
#   Moonshot    : sk-...
#   Anthropic   : sk-ant-...

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# LiteLLM 网关接入（先部署 deploy/litellm，使用仅限 agent-main 的应用虚拟密钥）
# LLM_PROVIDER=litellm
# LLM_BASE_URL=http://127.0.0.1:4000/v1
# LLM_MODEL=agent-main
# LLM_API_KEY=<应用虚拟密钥>
# LLM_TIMEOUT_SECONDS=420
# LLM_MAX_RETRIES=0
# 别名无法推断图片能力；当前 MiniMax-M3 渠道显式启用，备用模型也必须支持图片。
# LLM_VISION=1

# ── LangSmith 调用追踪（可选，默认关闭）──────────────────
# 开启后会将模型和工具调用的输入输出上传至指定 LangSmith 服务。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=astra-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 多工作区 API key 可指定工作区；区域不同需使用账户对应的 endpoint。
# LANGSMITH_WORKSPACE_ID=

# ── RagWiki 企业知识库──────────────────
# POST /api/v1/external/knowledge-bases/retrieval
# Headers: X-API-Key: <key>
# 招商只读查询接口：GET 使用 query 参数，POST 使用 JSON；留空不启用。
INVESTMENT_COMPANY_URL=
INVESTMENT_HISTORY_URL=
INVESTMENT_HTTP_METHOD=POST
INVESTMENT_API_KEY=
INVESTMENT_TIMEOUT_SECONDS=30

RAGWIKI_ENDPOINT=http://localhost:3001/api/v1/external/knowledge-bases/retrieval
RAGWIKI_API_KEY=rwk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAGWIKI_KNOWLEDGE_BASE_ID=6eb6e57a-4b6f-437f-8cb2-0068ee21c061
# RAGWIKI_RETRIEVAL_MODE=hybrid          # hybrid | vector | keyword
# RAGWIKI_TOP_K=8
# RAGWIKI_TIMEOUT_SECONDS=30

# ── 智能体工作目录（可选）────────────────────────────
# 上传文件落在这里的 uploads/ 下。**相对路径按项目根解析**（不是当前工作目录），
# 所以无论从哪里启动服务，文件都在 <项目根>/workspace/uploads。
# AGENT_WORKSPACE=./workspace

# ── Postgres（Web API 必需，CLI 可使用内存历史）──────────────
# POSTGRES_URL      → 对话历史及 Web 任务运行记录。Web API 启动时必须成功
#                     初始化运行记录，连接或建表失败会明确中止启动。
# POSTGRES_STORE_URL → 长期记忆（store）。同上。
# 两者可指向同一个库（表名不冲突）。
# ⚠️ Windows：psycopg 的异步模式需要 SelectorEventLoop —— uvicorn 带 --reload
#    启动时会自动选它；不带 --reload 会用 Proactor，届时会退回内存版并告警。
# POSTGRES_URL=postgresql://user:pass@host:5432/astra
# POSTGRES_STORE_URL=postgresql://user:pass@host:5432/astra

# ── 代码执行沙箱（可选，未配置则自动禁用）────────────
# 依赖 OpenSandbox 服务；未配置时 agent 仍可正常对话，
# 仅「执行代码」类工具会返回"暂不可用"。
# SANDBOX_BASE_URL=http://localhost:8080
# SANDBOX_API_KEY=
# Docker 后端通过管理服务代理访问执行端口，避免依赖宿主机随机端口的可达性。
SANDBOX_USE_SERVER_PROXY=false
# SANDBOX_IMAGE=python:3.11-slim
# 以下三项仅保留旧配置兼容，当前 PostgreSQL 流程尚未接入共享容量调度和空闲回收。
# SANDBOX_MAX_SANDBOXES=4
# SANDBOX_IDLE_TTL_SECONDS=600
# SANDBOX_CLEANUP_INTERVAL_SECONDS=30
# SANDBOX_CPU=1
# SANDBOX_MEMORY=1Gi
SANDBOX_VOLUME_ENABLED=false  # 新沙箱是否挂载宿主机数据卷；所有 API 实例保持一致
# SANDBOX_VOLUME_ROOT=/shared/astra-users  # 启用挂载时必填，需加入 OpenSandbox 服务端允许列表
# 用户卷归属使用 POSTGRES_URL；各实例必须连接同一数据库和 OpenSandbox 控制面。

# ── 上传文件存储（可选，默认本地磁盘）────────────────────
# STORAGE_DRIVER=local                # local | oss
# 默认落 <项目根>/workspace/uploads；下面的相对路径同样按项目根解析。
# STORAGE_LOCAL_ROOT=./workspace/uploads   # 仅 local 生效

# ── 阿里云 OSS（STORAGE_DRIVER=oss 时必填）──────────────
# 缺任一项会告警并自动退回 local，不会让服务起不来。
# Bucket 建议设为**私有**：预览走后端签发的 15 分钟临时 URL。
# 切勿设成公共读 —— 那等于把所有人的上传图片公开可枚举。
# OSS_ENDPOINT 只要裸域名，不要带 https://（程序会自动去掉，但写对更省事）
# STORAGE_DRIVER=oss
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_PREFIX=uploads

# ── MCP 服务（可选，未配置则不接入）──────────────────────
# 接入外部 MCP 服务，工具会以 mcp__{服务名}__{工具名} 注册给 agent。
# 未配置时 agent 照常对话；单个服务连不上/超时只丢它自己，不影响其他能力。
# 配好后先自检再开对话： python -m core.mcp
#
# 二选一：MCP_SERVERS 优先
# MCP_SERVERS={"docs":{"transport":"http","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer ${DOCS_MCP_TOKEN}"}},"fs":{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}}
# MCP_CONFIG_FILE=config/mcp.json
#
# 传输：stdio（本地子进程）/ http（streamable HTTP，远程服务）/ sse（老式远程）
# 可用字段：transport、enabled、command/args/env/cwd、url/headers、
#           include_tools/exclude_tools（最小权限）、connect_timeout_seconds
# 值里支持 ${VAR} / ${VAR:-默认值}，token 不要写进仓库。
#
# 本地演示服务（验证链路是否通）：
#   python scripts/demo_mcp_server.py --http 8791

# 本地链路追踪（无需 LangSmith key）；先启动 deploy/tracing/compose.yaml。
AGENT_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:3100/api/public/otel/v1/traces
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AGENT_TRACING_SAMPLE_RATE=1.0
# 本地调试可开启，记录经过凭证字段过滤和截断的对话/模型/工具输入输出。
AGENT_TRACING_CAPTURE_CONTENT=false
# 此开关独立于 LANGSMITH_TRACING；后者为 true 时仍会上传到 LangSmith。

# 每次 Agent 调用的图执行步数上限（不是工具次数），长任务仍应分段落盘。
AGENT_RECURSION_LIMIT=125
